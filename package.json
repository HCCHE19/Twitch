{
  "name": "lamplight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build && npm start",
    "demo": "npm run build && node dist/demo.js",
    "rebuild": "npm run build && node dist/rebuild.js",
    "verify": "npm run build && node dist/verify.js",
    "finalize": "npm run build && node dist/finalize.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json --noEmit",
    "secrets:check": "sh scripts/verify-secrets.sh"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.6"
  }
}
