# Register http://localhost:3939 as the app's first OAuth redirect URL (no trailing slash).
# Mint with: twitch token -u -p 3939 -s user:read:chat
# Never commit the real token.
TWITCH_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CHANNEL_LOGIN=
# Overlay windowsill position: bottom or top
LAYOUT=bottom
# One left-to-right wave when this many lamps are lit
THRESHOLD_N=10
# Set false to hide every overlay name plate and greeting
SHOW_NAMES=true
# Experimental mutual red threads; disabled for the recording fallback
THREADS=false
# Collect code-drawn zodiac fragments at the lamp threshold
SKY=false
# Five distinct flares in ten seconds briefly lean every flame
WIND=false
